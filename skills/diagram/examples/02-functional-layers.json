      "label": "HTTPS :443",
      "type": "primary"
    },
    {
      "from": "cloudflare",
      "to": "alb",
      "label": "origin pull :443",
      "type": "primary"
    },
    {
      "from": "alb",
      "to": "envoy",
      "label": "TLS end → :8443",
      "type": "primary"
    },
    {
      "from": "envoy",
      "to": "nextjs",
      "label": "HTTP/2 :3000",
      "type": "primary"
    },
    {
      "from": "nextjs",
      "to": "go_auth",
      "label": "gRPC :50051",
      "type": "primary"
    },
    {
      "from": "go_auth",
      "to": "spring_order",
      "label": "gRPC :50052",
      "type": "primary"
    },
    {
      "from": "spring_order",
      "to": "kafka",
      "label": "produce order.*",
      "type": "internal"
    },
    {
      "from": "kafka",
      "to": "py_ml",
      "label": "consume fraud.*",
      "type": "internal"
    },
    {
      "from": "kafka",
      "to": "go_billing",
      "label": "consume order.created",
      "type": "internal"
    },
    {
      "from": "go_billing",
      "to": "redis",
      "label": "SET NX lock",
      "type": "internal"
    },
    {
      "from": "go_billing",
      "to": "postgres",
      "label": "ACID tx :5432",
      "type": "internal"
    },
    {
      "from": "kafka",
      "to": "clickhouse",
      "label": "Kafka engine sink",
      "type": "internal"
    },
    {
      "from": "py_ml",
      "to": "s3",
      "label": "PUT model artifact",
      "type": "internal"
    },
    {
      "from": "gh_actions",
      "to": "argocd",
      "label": "bump tag",
      "type": "dashed"
    },
    {
      "from": "argocd",
      "to": "go_billing",
      "label": "sync manifests",
      "type": "dashed"
    },
    {
      "from": "prometheus",
      "to": "grafana",
      "label": "PromQL :9090",
      "type": "dashed"
    },
    {
      "from": "prometheus",
      "to": "go_auth",
      "label": "scrape /metrics",
      "type": "dashed"
    }
