{
  "mode": "stack",
  "title": "MSA Platform — Functional Layer & Split Storage View",
  "kicker": "layers / responsibility view",
  "lede": "The same 18 nodes and 17 edges as the infra view, regrouped by responsibility to separate OLTP from OLAP storage.",
  "icons": [
    "aws:aws/AWS-Cloud-logo",
    "vpc:aws/vpc",
    "alb:aws/alb",
    "s3:aws/s3",
    "cloudflare:cloudflare",
    "k8s:kubernetes",
    "envoy:envoy",
    "nextjs:nextjs",
    "go:go",
    "spring:spring",
    "python:python",
    "kafka:apache-kafka",
    "postgres:postgresql",
    "redis:redis",
    "clickhouse:clickhouse",
    "argocd:argo",
    "githubactions:github-actions",
    "prometheus:prometheus",
    "grafana:grafana",
    "user:lucide/users"
  ],
  "groups": [
    {
      "id": "edge_layer",
      "label": "Edge & Ingress Layer",
      "icon": "cloudflare",
      "style": "ga",
      "nodes": [
        "cloudflare",
        "alb"
      ]
    },
    {
      "id": "obs_stack",
      "label": "Observability",
      "icon": "prometheus",
      "style": "gb",
      "nodes": [
        "prometheus",
        "grafana"
      ]
    },
    {
      "id": "gitops",
      "label": "GitOps CI/CD",
      "icon": "githubactions",
      "style": "ga",
      "nodes": [
        "gh_actions",
        "argocd"
      ]
    },
    {
      "id": "sync_api",
      "label": "Synchronous API Mesh (K8s)",
      "icon": "k8s",
      "style": "gb",
      "nodes": [
        "envoy",
        "nextjs",
        "go_auth",
        "spring_order"
      ]
    },
    {
      "id": "async_stream",
      "label": "Event Streaming & Workers",
      "icon": "kafka",
      "style": "gb",
      "nodes": [
        "go_billing",
        "kafka",
        "py_ml"
      ]
    },
    {
      "id": "oltp_store",
      "label": "OLTP & Cache Storage",
      "icon": "postgres",
      "style": "aws private",
      "nodes": [
        "redis",
        "postgres"
